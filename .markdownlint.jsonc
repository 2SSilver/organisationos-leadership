// markdownlint config — relaxed prose, strict structure
{
  "default": true,
  "MD013": false,       // line-length — disabled (prose, not code)
  "MD024": { "siblings_only": true },  // duplicate-headings allowed in different sections
  "MD033": false,       // inline HTML allowed (for occasional <details>, <kbd>)
  "MD041": false,       // first line need not be h1 (some files start with frontmatter)
  "MD036": false,       // emphasis-as-heading allowed in compact templates
  "MD025": false        // multiple h1 allowed: agent/command definitions use h1 as section markers.
                        // NOTE: the previous value { "front_matter_title": "" } did NOT disable this
                        // rule — that option only changes where the title is looked for — so 22
                        // violations went unnoticed for as long as CI never ran.
}
